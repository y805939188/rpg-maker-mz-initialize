{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,

    "lib": [
      "ES2022",
      "DOM"
    ],

    "types": [],
    "skipLibCheck": true,

    "allowJs": false,
    "checkJs": false,

    "useDefineForClassFields": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },

  "include": [
    "plugins/**/*.ts",
    "types/**/*.d.ts",
    "typecheck-runtime.ts",
    "vite.config.mts"
  ],

  "exclude": [
    "node_modules",
    "../js"
  ]
}
